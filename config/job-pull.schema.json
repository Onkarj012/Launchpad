{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-search.local/schema/job-pull-policy-v2.json",
  "title": "Job Pull Policy V2",
  "type": "object",
  "required": ["schemaVersion", "timezone", "run", "freshness", "geo", "employment", "experience", "roles", "sources", "dedup"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "JobPullPolicyV2" },
    "timezone": { "const": "Asia/Kolkata" },
    "run": {
      "type": "object",
      "required": ["cadence", "onceDaily", "minimumTotal", "maximumTotal", "strictTarget", "maximumPerCompany", "maximumFamilyShare"],
      "properties": {
        "cadence": { "const": "manual" },
        "onceDaily": { "const": true },
        "minimumTotal": { "const": 25 },
        "maximumTotal": { "const": 35 },
        "strictTarget": { "const": 10 },
        "maximumPerCompany": { "const": 2 },
        "maximumFamilyShare": { "const": 0.4 }
      },
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "required": ["hotMaximumHours", "activeMaximumDays", "backfillMaximumDays"],
      "properties": {
        "hotMaximumHours": { "const": 72 },
        "activeMaximumDays": { "const": 7 },
        "backfillMaximumDays": { "const": 14 }
      },
      "additionalProperties": false
    },
    "geo": {
      "type": "object",
      "required": ["homeCountry", "puneMetroAliases", "remoteAllowedScopes", "remoteDeniedScopes"],
      "properties": {
        "homeCountry": { "const": "India" },
        "puneMetroAliases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "remoteAllowedScopes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "remoteDeniedScopes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "employment": {
      "type": "object",
      "required": ["allowedTypes", "internshipRequiresExplicitPaid", "rejectUnpaid"],
      "properties": {
        "allowedTypes": { "const": ["full-time", "internship"] },
        "internshipRequiresExplicitPaid": { "const": true },
        "rejectUnpaid": { "const": true }
      },
      "additionalProperties": false
    },
    "experience": {
      "type": "object",
      "required": ["strictMaximumYears", "relaxedMaximumYears", "hardRejectMinimumYears"],
      "properties": {
        "strictMaximumYears": { "const": 1 },
        "relaxedMaximumYears": { "const": 2 },
        "hardRejectMinimumYears": { "const": 3 }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "required": ["families", "maximumFamilyShare"],
      "properties": {
        "families": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "maximumFamilyShare": { "const": 0.4 }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "required": ["qualityOrder", "reverseAts"],
      "properties": {
        "qualityOrder": { "const": ["ats-direct", "niche-public", "aggregator"] },
        "reverseAts": { "const": ["greenhouse", "lever", "ashby", "workday"] }
      },
      "additionalProperties": false
    },
    "dedup": {
      "type": "object",
      "required": ["simHashEnabled", "simHashSimilarity"],
      "properties": {
        "simHashEnabled": { "const": true },
        "simHashSimilarity": { "const": 0.93 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
