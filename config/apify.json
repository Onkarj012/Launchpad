{
  "$schema": "https://apify.com (no local schema — see references/sourcing.md)",
  "note": "Manual rescue only. Profiles are disabled by default and never selected without --profile. No profile is part of Normal, Startup, or Remote daily discovery. Run: node job-pull/apify-pull.mjs --profile <stable-name> --out RAW.json --config config/apify.json.",
  "rescue": {
    "defaultEnabled": false,
    "maxProfilesPerRun": 3,
    "runTimeoutSeconds": 600,
    "monthlyBudgetUsd": 15,
    "maxRunsPerMonth": 15,
    "maxRunCostUsd": 1,
    "maxReturnedItemsPerProfile": 250
  },
  "actors": [
    {
      "profile": "linkedin-jobs",
      "id": "cheap_scraper~linkedin-job-scraper",
      "label": "linkedin",
      "enabled": false,
      "sourceKind": "niche-public",
      "sourceCategory": "india-niche",
      "input": {
        "keyword": ["software engineer", "AI engineer", "machine learning engineer", "backend developer", "new grad software engineer"],
        "locations": ["Pune, Maharashtra, India", "India"],
        "publishedAt": "r604800",
        "jobType": ["full-time", "internship"],
        "experienceLevel": ["internship", "entry-level"],
        "workType": ["on-site", "hybrid", "remote"],
        "maxItems": 150,
        "saveOnlyUniqueItems": true
      },
      "fieldMap": {
        "url": "jobUrl",
        "discoveryUrl": "jobUrl",
        "company": "companyName",
        "title": "jobTitle",
        "postedAt": "publishedAt",
        "location": "location",
        "description": "jobDescription"
      }
    },
    {
      "profile": "naukri-fresher",
      "id": "blackfalcondata~naukri-jobs-feed",
      "label": "naukri",
      "enabled": false,
      "sourceKind": "niche-public",
      "sourceCategory": "india-niche",
      "input": {
        "searchQueries": [
          "software engineer fresher Pune",
          "AI engineer fresher Pune",
          "machine learning engineer Pune",
          "backend developer python Pune",
          "graduate engineer trainee Pune",
          "associate software engineer Pune",
          "junior software developer Pune",
          "GenAI engineer Pune",
          "python FastAPI developer Pune",
          "Django developer Pune",
          "junior backend developer Pune"
        ],
        "experience": "0-2",
        "datePosted": "7d",
        "fetchDetails": true,
        "maxResults": 100,
        "descriptionFormat": "text"
      },
      "fieldMap": {
        "url": "portalUrl",
        "discoveryUrl": "portalUrl",
        "company": "companyName",
        "title": "title",
        "postedAt": "createdDate",
        "location": "location",
        "description": "description"
      }
    },
    {
      "profile": "foundit-fresher",
      "id": "scrapesage~foundit-scraper",
      "label": "foundit",
      "enabled": false,
      "sourceKind": "niche-public",
      "sourceCategory": "india-niche",
      "input": {
        "searchQueries": ["software engineer fresher", "AI engineer", "machine learning engineer fresher", "python developer fresher", "backend developer fresher"],
        "region": "india",
        "locations": ["Pune"],
        "sortBy": "date",
        "freshnessDays": 7,
        "includeDescription": true,
        "maxResults": 100
      },
      "fieldMap": {
        "url": "jobUrl",
        "discoveryUrl": "jobUrl",
        "company": "company",
        "title": "title",
        "postedAt": "postedAt",
        "location": "location",
        "description": "description"
      }
    },
    {
      "profile": "hirist-fresher",
      "id": "logiover~hirist-tech-scraper",
      "label": "hirist",
      "enabled": false,
      "sourceKind": "niche-public",
      "sourceCategory": "india-niche",
      "_note": "scrapeDetails must stay true — with it off the actor emits description: null and every record fails downstream gates.",
      "input": {
        "keywords": ["python", "machine-learning", "node-js"],
        "cities": ["pune", "remote", "anywhere in india"],
        "experience": "0-2",
        "maxJobs": 60,
        "maxPages": 5,
        "scrapeDetails": true
      },
      "fieldMap": {
        "url": "url",
        "discoveryUrl": "url",
        "company": "company",
        "title": "title",
        "postedAt": "postedAt",
        "location": "location",
        "description": "description"
      }
    },
    {
      "profile": "wellfound-india",
      "id": "blackfalcondata~wellfound-scraper",
      "label": "wellfound",
      "enabled": false,
      "sourceKind": "niche-public",
      "sourceCategory": "india-niche",
      "_note": "Manual rescue profile; never part of daily discovery.",
      "input": {
        "roles": ["software-engineer", "data-scientist"],
        "location": ["india"],
        "jobType": "fulltime",
        "experienceLevel": "entry",
        "maxResults": 100
      },
      "fieldMap": {
        "url": "portalUrl",
        "discoveryUrl": "portalUrl",
        "company": "companyName",
        "title": "title",
        "postedAt": "postedAt",
        "location": "locationNames",
        "description": "description"
      }
    },
    {
      "profile": "cutshort-india",
      "id": "thirdwatch~cutshort-jobs-scraper",
      "label": "cutshort",
      "enabled": false,
      "sourceKind": "niche-public",
      "sourceCategory": "india-niche",
      "_note": "No posting-date output field is confirmed; undated records remain verification-only downstream.",
      "input": {
        "skills": ["python", "machine-learning", "backend", "full-stack", "react", "node-js"],
        "maxResults": 60
      },
      "fieldMap": {
        "url": "apply_url",
        "discoveryUrl": "apply_url",
        "company": "company_name",
        "title": "title",
        "location": "location",
        "description": "description"
      }
    }
  ]
}
