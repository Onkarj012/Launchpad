      "maxPages": 1,
      "maxJobs": 100,
      "enrichDetails": true
    },
    "atsBatch2": { "boards": [] },
    "enterprise": { "boards": [] },
    "careerSites": [],
    "careerOptions": {
      "maxPagesPerCompany": 25,
      "hostLimiterOptions": { "minSpacingMs": 1000, "maxConcurrency": 1 },
      "retry": { "maxAttempts": 3 }
    },
    "searxng": {
      "enabled": true,
      "endpoint": "http://127.0.0.1:8080",
      "dailyBudget": 20,
      "perQueryResultCap": 10,
      "queries": [
        "\"AI Engineer\" Pune fresher jobs",
        "\"Machine Learning Engineer\" India \"0-2 years\" jobs",
        "\"Backend Engineer\" Python Pune graduate jobs",
        "\"Software Engineer\" India new grad careers",
        "\"Generative AI\" engineer India fresher careers",
        "site:ycombinator.com/jobs India (\"software engineer\" OR \"AI engineer\" OR \"ML engineer\")",
        "site:wellfound.com/jobs India remote (junior OR fresher OR \"new grad\") engineer",
        "site:cutshort.io/job India (AI OR Python OR backend OR \"full stack\") (fresher OR junior)",
        "site:peerlist.io/company/*/careers India (AI OR software OR backend) engineer",
        "(site:jobs.ashbyhq.com OR site:job-boards.greenhouse.io OR site:jobs.lever.co) India remote startup (AI OR ML OR Python) engineer",
        "(Accel OR Peak XV OR Blume Ventures OR Lightspeed India OR Elevation Capital) portfolio careers India engineer"
      ]
    },
    "chromium": {
      "enabled": false,
      "renderHosts": []
    },
    "brave": {
      "enabled": false,
      "apiKeyEnv": "BRAVE_SEARCH_API_KEY",
      "dailyBudget": 20,
      "perQueryResultCap": 10,
      "queries": []
    },
    "indeed": {
      "enabled": false,
      "inboxDir": "connector-inbox/indeed"
    },
    "indiaStartup": {
      "enabled": false,
      "requests": [],
      "queryBudget": 20
    },
    "commercialRescue": {
      "enabled": false,
      "targetReserve": 12,
      "maxRecords": 100,
      "maxCostUsd": 5
    }
  },
  "sourceYield": {
    "minimumFetchedForReview": 100,
    "minimumRunsForPause": 3
  }
