    "atsBatch1": {
      "boards": [
        { "provider": "smartrecruiters", "board": "BoschGroup", "company": "Bosch Group", "country": "in" },
        { "provider": "smartrecruiters", "board": "Visa", "company": "Visa", "country": "in" }
